<?xml version="1.0" encoding="utf-8"?>
<!--
    主页（频道浏览页）：RecyclerView 内容延伸到系统栏与顶部浮层后方，
    顶部「Toolbar + 分类 Chip」为半透明浮层，由 MainActivity 负责 Insets 避让。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- 频道列表：铺满全屏，滚动内容绘制在浮层与系统栏后方，避让量由代码按 Insets 与浮层实测高度设置 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/browse_channel_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/browse_list_max_width" />

    <!-- 顶部浮层：Toolbar + 分类筛选，半透明表面（背景不透明度由代码按 230/255 沉浸表面约定设置） -->
    <LinearLayout
        android:id="@+id/browse_overlay_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/dp_4"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/browse_list_max_width">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/browse_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextColor="?attr/colorOnSurface" />

        <!-- 分类横向单选：Chip 由程序化生成（最近观看 / 央视 / 卫视 / 外国频道 / 自定义） -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/browse_category_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_16"
                android:paddingTop="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_8"
                app:chipSpacingHorizontal="@dimen/dp_8"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 加载态：首数据到达前展示 -->
    <LinearLayout
        android:id="@+id/browse_loading_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/loading_channels"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/sp_14" />
    </LinearLayout>

    <!-- 空态文案：原因（搜索无结果 / 暂无收藏 / 频道列表为空）由 ViewModel 下发 -->
    <TextView
        android:id="@+id/browse_empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/sp_14"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
