<?xml version="1.0" encoding="utf-8"?>
<!--
    频道列表条目：频道名 + 可换行的分类与信号源摘要 + 收藏星标。
    星标图标由 selector_favorite_star 按 selected 状态切换实心 / 描边，
    选中态颜色与无障碍文案（favorite_add / favorite_remove）由列表适配器绑定。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_focusable_item"
    android:focusable="true"
    android:minHeight="@dimen/dp_72"
    android:paddingStart="@dimen/dp_16"
    android:paddingTop="@dimen/dp_12"
    android:paddingEnd="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_12">

    <TextView
        android:id="@+id/channel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_12"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/channel_favorite_star"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 同一摘要在可用宽度内换行，避免大字体下分类与信号源数挤入收藏区。 -->
    <TextView
        android:id="@+id/channel_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginEnd="@dimen/dp_12"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/sp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/channel_favorite_star"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/channel_name" />

    <ImageButton
        android:id="@+id/channel_favorite_star"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:background="@drawable/bg_focusable_item"
        android:contentDescription="@string/favorite_add"
        android:scaleType="centerInside"
        android:src="@drawable/selector_favorite_star"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
