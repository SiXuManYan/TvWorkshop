<?xml version="1.0" encoding="utf-8"?>
<!-- 播放页：全屏纯黑播放器，覆盖层为半透明顶栏 / 中央缓冲 / 错误浮层 / 底部操作条。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_player_background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/player_toggle_controls"
        android:focusable="true"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- 覆盖层根容器：自身不拦截点击，空白区域穿透到播放区用于切换浮层显隐 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 顶栏：返回、频道名、分类名、收藏 -->
        <LinearLayout
            android:id="@+id/player_top_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/tv_player_control_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dp_4"
            android:paddingTop="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_player_back"
                style="@style/Widget.TvWorkshop.PlayerIconButton"
                android:contentDescription="@string/player_back"
                android:src="@drawable/ic_player_back"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_player_channel_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_18"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_player_category_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_player_favorite"
                style="@style/Widget.TvWorkshop.PlayerIconButton"
                android:contentDescription="@string/favorite_add"
                android:src="@drawable/ic_player_favorite_outline"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- 中央缓冲指示器：仅在缓冲且无错误时显示 -->
        <ProgressBar
            android:id="@+id/player_buffering"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/white"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 错误内容在上下操作条之间独立滚动，大字体与短窗口下仍能触达重试。 -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/player_error_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginVertical="@dimen/dp_8"
            android:fillViewport="true"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/player_bottom_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_top_bar"
            app:layout_constraintWidth_max="@dimen/dp_400">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@color/tv_player_control_background"
                    app:cardCornerRadius="@dimen/dp_16"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/dp_16">

                        <ImageView
                            android:id="@+id/iv_player_error_icon"
                            android:layout_width="@dimen/dp_32"
                            android:layout_height="@dimen/dp_32"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_player_error"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_player_error_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_12"
                            android:gravity="center"
                            android:text="@string/play_error"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sp_16" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_player_retry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_16"
                            android:minHeight="@dimen/dp_48"
                            android:text="@string/action_retry" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_player_error_switch_source"
                            style="@style/Widget.TvWorkshop.PlayerTextButton"
                            android:layout_width="match_parent"
                            android:layout_marginTop="@dimen/dp_4"
                            android:maxLines="2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 换台 OSD：频道变化时中央显示频道名，短暂停留后淡出 -->
        <TextView
            android:id="@+id/tv_player_osd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:background="@drawable/bg_player_osd"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="@dimen/dp_320"
            android:paddingStart="@dimen/dp_24"
            android:paddingTop="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_24"
            android:paddingBottom="@dimen/dp_10"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.35" />

        <!-- 上下频道固定在两端，中部操作可横向滚动，窄窗口与大字体下仍可到达所有入口。 -->
        <LinearLayout
            android:id="@+id/player_bottom_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/tv_player_control_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dp_8"
            android:paddingTop="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_player_prev"
                style="@style/Widget.TvWorkshop.PlayerIconButton"
                android:contentDescription="@string/action_prev_channel"
                android:src="@drawable/ic_player_prev"
                app:tint="@color/white" />

            <HorizontalScrollView
                android:id="@+id/player_actions_scroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btn_player_channel_list"
                        style="@style/Widget.TvWorkshop.PlayerIconButton"
                        android:contentDescription="@string/player_channel_list"
                        android:src="@drawable/ic_player_channel_list"
                        app:tint="@color/white" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_player_switch_source"
                        style="@style/Widget.TvWorkshop.PlayerTextButton"
                        android:drawableStart="@drawable/ic_player_source"
                        android:drawablePadding="@dimen/dp_6" />

                    <!-- 清晰度选择仅在提供多档画质时显示。 -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_player_quality"
                        style="@style/Widget.TvWorkshop.PlayerTextButton"
                        android:contentDescription="@string/player_quality"
                        android:drawableStart="@drawable/ic_player_quality"
                        android:drawablePadding="@dimen/dp_4"
                        android:text="@string/quality_auto"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btn_player_pip"
                        style="@style/Widget.TvWorkshop.PlayerIconButton"
                        android:contentDescription="@string/player_pip"
                        android:src="@drawable/ic_player_pip"
                        app:tint="@color/white" />
                </LinearLayout>
            </HorizontalScrollView>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_player_next"
                style="@style/Widget.TvWorkshop.PlayerIconButton"
                android:contentDescription="@string/action_next_channel"
                android:src="@drawable/ic_player_next"
                app:tint="@color/white" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
