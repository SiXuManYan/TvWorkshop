<?xml version="1.0" encoding="utf-8"?>
<!--
    导入频道源对话框内容：多行输入（m3u 订阅地址或订阅正文）+ 导入进行中的进度指示。
    按钮与进度显隐由 MainActivity 在导入任务进行中控制。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_24"
        android:paddingTop="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_24"
        android:paddingBottom="@dimen/dp_16">

        <!-- 长说明独立换行，浮动标签只保留简短名称。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_12"
            android:text="@string/import_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/import_input_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/import_input_label">

            <!-- 限制可见行数而非正文长度，大列表在输入区内滚动。 -->
            <com.sugar.tv.browse.PlaylistInputEditText
                android:id="@+id/import_input_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:maxLines="6"
                android:minLines="4"
                android:scrollbars="vertical" />
        </com.google.android.material.textfield.TextInputLayout>

        <ProgressBar
            android:id="@+id/import_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_16"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
