<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 入口行统一触达范围与文字层级，避免三份布局逐渐偏离。 -->
    <style name="Widget.TvWorkshop.DocumentRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/dp_80</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">@dimen/dp_20</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:screenReaderFocusable">true</item>
    </style>
    <style name="Widget.TvWorkshop.DocumentRowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Widget.TvWorkshop.DocumentRowTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Widget.TvWorkshop.DocumentRowSummary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/dp_4</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.TvWorkshop.DocumentRowChevron" parent="">
        <item name="android:layout_width">@dimen/dp_24</item>
        <item name="android:layout_height">@dimen/dp_24</item>
        <item name="android:layout_marginStart">@dimen/dp_12</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_document_chevron</item>
    </style>
</resources>
