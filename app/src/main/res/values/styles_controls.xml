<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 图标按钮统一保留 48dp 触达区，焦点与按压样式独立于系统深浅色。 -->
    <style name="Widget.TvWorkshop.PlayerIconButton" parent="">
        <item name="android:layout_width">@dimen/dp_48</item>
        <item name="android:layout_height">@dimen/dp_48</item>
        <item name="android:background">@drawable/bg_player_control</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:padding">@dimen/dp_12</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- 文字按钮允许随字号增高；受限宽度由具体布局决定换行或省略方式。 -->
    <style name="Widget.TvWorkshop.PlayerTextButton" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">@dimen/dp_48</item>
        <item name="android:minHeight">@dimen/dp_48</item>
        <item name="android:background">@drawable/bg_player_control</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:paddingStart">@dimen/dp_12</item>
        <item name="android:paddingEnd">@dimen/dp_12</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">@dimen/sp_14</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:drawableTint">@color/white</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- 播放设置固定深色，浅色系统主题下也与视频控件保持一致。 -->
    <style name="ThemeOverlay.TvWorkshop.PlayerPopup" parent="ThemeOverlay.AppCompat.Dark" />
    <!-- 选台面板固定深色，输入、列表和焦点在浅色系统主题下仍与播放区一致。 -->
    <style name="ThemeOverlay.TvWorkshop.PlayerPanel" parent="ThemeOverlay.Material3.Dark">
        <item name="colorSurface">@color/tv_player_panel_background</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/tv_player_panel_secondary_text</item>
        <item name="colorPrimary">@color/tv_player_panel_accent</item>
        <item name="colorOutline">@color/tv_player_panel_secondary_text</item>
    </style>
</resources>
